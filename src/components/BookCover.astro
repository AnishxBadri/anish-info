---
import { Image } from "astro:assets";
import type { Book } from "../lib/content";

interface Props {
  book: Book;
  size?: "sm" | "md" | "lg";
  eager?: boolean;
}

const { book, size = "md", eager = false } = Astro.props;
const { title, author, cover, coverColor, coverInk, coverStyle, status } = book.data;

const width = { sm: 56, md: 136, lg: 200 }[size];
const height = Math.round(width * 1.5);
const unread = status === "want";
---

<div
  class:list={["cover", size, coverStyle, { unread }]}
  style={{ "--cover-bg": coverColor, "--cover-ink": coverInk, width: `${width}px`, height: `${height}px` }}
  aria-hidden="true"
>
  {
    cover && !unread ? (
      <Image src={cover} alt="" width={width * 2} class="img" loading={eager ? "eager" : "lazy"} />
    ) : (
      <>
        <span class="title">{title}</span>
        {size !== "sm" && <span class="author">{author}</span>}
      </>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 14px 12px;
    background: var(--cover-bg);
    color: var(--cover-ink);
    border-radius: 2px;
    overflow: hidden;
    box-shadow:
      inset 3px 0 0 rgb(0 0 0 / 0.14),
      0 1px 2px rgb(22 22 20 / 0.12);
  }
  .cover.lg {
    padding: 20px 18px;
    box-shadow:
      inset 4px 0 0 rgb(0 0 0 / 0.15),
      0 2px 4px rgb(22 22 20 / 0.1),
      0 12px 32px rgb(22 22 20 / 0.14);
  }
  .cover.sm {
    padding: 7px 6px;
  }
  .img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.08;
  }
  .sans .title {
    font-family: var(--font-sans);
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    font-size: 16px;
  }
  .italic .title {
    font-weight: 400;
    font-style: italic;
  }
  .lg .title {
    font-size: 26px;
  }
  .lg.sans .title {
    font-size: 22px;
  }
  .sm .title {
    font-size: 9px;
    line-height: 1.1;
  }

  .author {
    font-family: var(--font-sans);
    font-size: 8px;
    line-height: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .lg .author {
    font-size: 10px;
    line-height: 12px;
  }

  .unread {
    background: transparent;
    color: var(--color-graphite);
    border: 1px dashed #b9b7af;
    box-shadow: none;
  }
  .unread .title {
    font-weight: 400;
  }
</style>
