---
interface Props {
  date: Date;
  month?: "long" | "short";
  day?: boolean;
}

const { date, month = "long", day = true } = Astro.props;
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString("en-US", {
      year: "numeric",
      month,
      day: day ? "numeric" : undefined,
      timeZone: "UTC",
    })
  }
</time>
