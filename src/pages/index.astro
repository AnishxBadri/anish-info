---
import { EMAIL, SOCIALS } from "../consts";
import Page from "../layouts/Page.astro";
import { getBooks, getEssays, hasPage } from "../lib/content";

const [latest] = await getEssays();
const reading = (await getBooks()).filter((b) => b.data.status === "reading");
---

<Page active="home">
  <div class="intro">
    <h1 class="name">Anish Badri</h1>

    <p class="lede">
      I'm building Parrot Prep, a tool that I hope becomes the infrastructure for your job search.
    </p>

    <div class="about">
      <p>I also write, draw, and review the books I read. Some other things about me:</p>
      <ul>
        <li>Graduated from UCLA with a BS in Computer Science</li>
        <li>Did machine learning research at the Ozcan Research Lab</li>
        <li>Interned at Brilliant Smart Home</li>
        <li>Working on an open source Rust TUI tool</li>
        <li>Currently grokking Rust and Zig, while dabbling in Go</li>
      </ul>
      <p class="chat">Want to chat? Drop me a note at <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
    </div>

    <ul class="socials">
      {
        SOCIALS.map((s) => (
          <li>
            <a href={s.href} rel="me">
              {s.label} ↗
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div slot="margin" class="aside">
    {
      latest && (
        <section>
          <span class="label">Latest essay</span>
          <a class="strong" href={`/writing/${latest.id}`}>
            {latest.data.title} →
          </a>
        </section>
      )
    }
    {
      reading.length > 0 && (
        <section>
          <span class="label">Reading</span>
          {reading.map((book) => (
            <>
              <a class="strong" href={hasPage(book) ? `/library/${book.id}` : "/library"}>
                {book.data.title} →
              </a>
              {book.data.currentPage && book.data.pages && (
                <span class="muted">
                  p. {book.data.currentPage} of {book.data.pages}
                </span>
              )}
            </>
          ))}
        </section>
      )
    }
  </div>
</Page>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .name {
    font-size: var(--text-ui);
    line-height: 20px;
    font-weight: 400;
  }
  .lede {
    font-family: var(--font-serif);
    font-size: clamp(28px, 2.8vw, 34px);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .about {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 30px;
  }
  .about ul {
    padding-left: 1.1em;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .about li::marker {
    color: var(--color-graphite);
  }
  .chat {
    padding-top: 24px;
  }
  .chat a {
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 4px;
  }
  .socials {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 14px;
    color: var(--color-graphite);
    margin-top: -32px;
  }

  .aside {
    padding-top: 76px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .aside section {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: var(--text-note);
    line-height: 20px;
  }
  .strong {
    font-weight: 500;
  }
  @media (max-width: 1179px) {
    .aside {
      padding-top: 0;
    }
  }
</style>
